/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  # Cloudflare Pages はHTMLの <link rel="preload"> を Link ヘッダーに自動で写すが、
  # そのとき URL の &amp; を戻さずに写すため、Googleフォントの指定が壊れたURLで
  # もう1回読み込まれていた（2026-09-19 確認）。先読みはHTML側に残っているので外す。
  ! Link

# Next.js が出力するプログラム・CSSはファイル名に中身のハッシュが入っていて、
# 中身が変わると名前も変わる。だから1年保存させても古いものが出ることはない。
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# 画像は同じファイル名のまま差し替えることがあるので、7日にとどめる。
/images/*
  Cache-Control: public, max-age=604800
